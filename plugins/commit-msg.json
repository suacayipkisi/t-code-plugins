{
  "id": "commit-msg",
  "name": "Commit Message Helper",
  "provider": "t-code",
  "description": "Guesses the Conventional Commits type and scope of the staged files (fix(lsp): ...), asks for the subject and fills Source Control's message box. Written in Go, built once with go.",
  "version": "0.1.0",
  "api": "tapi_1",
  "repository": "https://github.com/suacayipkisi/t-code",
  "commit": "0333e7ea4ddac6f10223f4c8318b1beaf5aabdda",
  "path": "plugins/builtin/commit-msg",
  "tree-sha256": "267ccc3606fc5808a659ac6abb14946392602a15de42f728cdbf10270b02bf60",
  "permissions": [],
  "categories": [
    "git"
  ],
  "reviewed": false,
  "requires": [
    {
      "program": "go",
      "for": "building the plugin once",
      "install": {
        "fedora": "sudo dnf install golang",
        "debian": "sudo apt install golang-go",
        "arch": "sudo pacman -S go",
        "opensuse": "sudo zypper install go"
      }
    },
    {
      "program": "git",
      "for": "reading the staged files",
      "install": {
        "fedora": "sudo dnf install git",
        "debian": "sudo apt install git",
        "arch": "sudo pacman -S git",
        "opensuse": "sudo zypper install git"
      }
    }
  ]
}
