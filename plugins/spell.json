{
  "id": "spell",
  "name": "Spell Check",
  "provider": "t-code",
  "description": "Underlines misspelled words in Markdown and text files and in source files' comments when they open or are saved; fixes the word at the cursor from hunspell's suggestions. Needs hunspell and a dictionary; written in C++, built once with the system's C++ compiler.",
  "version": "0.1.0",
  "api": "tapi_1",
  "repository": "https://github.com/suacayipkisi/t-code",
  "commit": "0333e7ea4ddac6f10223f4c8318b1beaf5aabdda",
  "path": "plugins/builtin/spell",
  "tree-sha256": "4653f87591a11fd9ee7bba47fcf3bd728cb6a1f094530c55dab34e4ee31c7be0",
  "permissions": [
    "edit",
    "start"
  ],
  "categories": [
    "linters"
  ],
  "reviewed": false,
  "requires": [
    {
      "program": [
        "c++",
        "g++",
        "clang++"
      ],
      "for": "building the plugin once",
      "install": {
        "fedora": "sudo dnf install gcc-c++",
        "debian": "sudo apt install g++",
        "arch": "sudo pacman -S gcc",
        "opensuse": "sudo zypper install gcc-c++"
      }
    },
    {
      "program": "hunspell",
      "for": "the spelling and its English dictionary",
      "install": {
        "fedora": "sudo dnf install hunspell hunspell-en-US",
        "debian": "sudo apt install hunspell hunspell-en-us",
        "arch": "sudo pacman -S hunspell hunspell-en_us",
        "opensuse": "sudo zypper install hunspell myspell-en_US"
      }
    }
  ]
}
