{
  "id": "latex",
  "name": "LaTeX and Typst",
  "provider": "t-code",
  "description": "Builds a LaTeX or Typst document when one of its files is saved, with its errors in Problems and its state in the status bar; opens the PDF. Needs latexmk, tectonic or pdflatex, or typst; written in Rust, built once with cargo.",
  "version": "0.1.0",
  "api": "tapi_1",
  "repository": "https://github.com/suacayipkisi/t-code",
  "commit": "0333e7ea4ddac6f10223f4c8318b1beaf5aabdda",
  "path": "plugins/builtin/latex",
  "tree-sha256": "e77f941c46210e4a31a97dfa7e45b390a345010d075ddde2b0766bf5d8788745",
  "permissions": [
    "start"
  ],
  "categories": [
    "documents"
  ],
  "reviewed": false,
  "requires": [
    {
      "program": "cargo",
      "for": "building the plugin once",
      "install": {
        "fedora": "sudo dnf install cargo",
        "debian": "sudo apt install cargo",
        "arch": "sudo pacman -S rust",
        "opensuse": "sudo zypper install cargo"
      }
    },
    {
      "program": [
        "latexmk",
        "tectonic",
        "pdflatex",
        "typst"
      ],
      "for": "building the documents",
      "install": {
        "fedora": "sudo dnf install latexmk texlive-scheme-basic",
        "debian": "sudo apt install latexmk texlive-latex-recommended",
        "arch": "sudo pacman -S texlive-binextra texlive-latex",
        "opensuse": "sudo zypper install texlive-latexmk texlive-scheme-basic"
      }
    }
  ]
}
